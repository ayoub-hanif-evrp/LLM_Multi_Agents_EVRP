      "sources": {
        "insertion_score": "def insertion_score(delta_distance: float, due_time: float, ready_time: float, demand: float, capacity_slack: float) -> float:\n    \"\"\"Lower is better. Single arithmetic return for the bounded interpreter.\"\"\"\n    return delta_distance + (0.0 if due_time >= 1000000.0 else (0.01 * due_time + 1.0 / max(due_time - ready_time, 1.0))) + (0.0 if capacity_slack >= demand else 1000000.0)\n",
        "station_score": "def station_score(detour: float, battery_arrival: float, station_rate: float) -> float:\n    \"\"\"Lower is better when choosing a station to insert.\"\"\"\n    # Base score is detour distance\n    score = detour\n    \n    # Penalty for low battery arrival (higher penalty when battery is very low)\n    if battery_arrival < 0.2:\n        score += 1000 * (1 - battery_arrival)\n    elif battery_arrival < 0.4:\n        score += 100 * (1 - battery_arrival)\n    \n    # Penalty for expensive charging rate\n    score += station_rate * 10\n    \n    return score",
        "removal_priority": "def removal_priority(due_time: float, route_distance_share: float, rng_value: float) -> float:\n    # Normalize due_time to [0,1] range (1e6 maps to 0)\n    normalized_due = 1.0 - min(due_time / 1000000.0, 1.0)\n    \n    # Combine factors with weights\n    # Due time is more important than distance share\n    priority = 0.7 * normalized_due + 0.3 * route_distance_share\n    \n    # Add randomness to break ties\n    priority += 0.01 * rng_value\n    \n    return priority"
      },
      "owners": {
